{
  "[python]": {
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.defaultFormatter": "ms-python.autopep8",
  },
  "autopep8.args": [
    "--max-line-length",
    "100",
    "--experimental",
    "--indent-size",
    "2",
  ],
  "editor.rulers": [80, 100],
  "editor.tabSize": 2,
  "editor.indentSize": "tabSize",
}
